<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etAuthorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Author Name" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/etPaperTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paper Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presentation Type:"
            android:layout_marginTop="10dp"/>

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbOral" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Oral" />
            <RadioButton android:id="@+id/rbPoster" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Poster" />
            <RadioButton android:id="@+id/rbVirtual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Virtual" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Research Domain:"
            android:layout_marginTop="10dp"/>

        <Spinner
            android:id="@+id/spinnerDomain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/domains"/>

        <ToggleButton
            android:id="@+id/toggleCoAuthors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="Hide Co-authors"
            android:textOff="Add Co-authors"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:id="@+id/layoutCoAuthors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <CheckBox android:id="@+id/cbCo1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Co-author 1" />
            <CheckBox android:id="@+id/cbCo2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Co-author 2" />
            <CheckBox android:id="@+id/cbCo3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Co-author 3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">
            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Back" />
            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>